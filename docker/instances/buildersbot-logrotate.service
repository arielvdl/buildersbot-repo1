# Rotates the container logs of the Builders Bot instances. buildersbot-logrotate.timer starts it.
# `buildersbot-instance setup` installs it. See docs/docker.md#logs.
[Unit]
Description=Rotate the container logs of the Builders Bot instances

[Service]
Type=oneshot
ExecStart=/usr/sbin/logrotate --state /var/lib/logrotate/buildersbot-docker.status /etc/buildersbot-docker/logrotate.conf
