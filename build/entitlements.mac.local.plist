<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      Entitlements for a local build signed with a self-signed identity
      ("Builder Studio Local Signing").

      `com.apple.developer.associated-domains` and
      `com.apple.developer.team-identifier` are deliberately absent: AMFI kills
      the process at exec (exit 137) when the signing certificate is not the
      Apple Developer ID of that team. The security entitlements below are the
      ones that still apply without the hardened runtime.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
