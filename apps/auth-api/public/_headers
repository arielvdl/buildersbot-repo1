# Workers static assets read this file. Vite puts a content hash in every name
# under /assets/, so a changed file always has a new URL and a browser can keep
# the old one for a year without asking again.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The worker covers the whole origin, and the browser must see a new version at the next start
# instead of a copy it already has. `/offline.html` is the fallback the worker keeps.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/offline.html
  Cache-Control: public, max-age=0, must-revalidate

# The manifest is read on every install, so a renamed app or a new icon shows without a release gap.
/site.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json

# The home page is a static file. A changed page must show at the next visit, so the edge and the
# browser check it again each time.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
