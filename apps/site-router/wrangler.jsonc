{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buildersbot-site-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "*.sites.buildersbot.culturabuilder.com/*",
      "zone_name": "culturabuilder.com"
    }
  ],
  "vars": {
    // The account service origin. The report route `/_buildersbot/report` and the links on error pages use it.
    "ACCOUNT_ORIGIN": "https://buildersbot.culturabuilder.com"
  },
  "r2_buckets": [
    {
      "binding": "SITES",
      "bucket_name": "buildersbot-sites",
      "preview_bucket_name": "buildersbot-sites-test"
    }
  ]
}
