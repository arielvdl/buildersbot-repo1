#!/bin/bash
# buildersbot-boat-pre-stop: installed by buildersbot-hosted-update. Changes to this file are replaced.
#
# boat runs /home/user/.boat/pre-stop as the sandbox user when a stop starts, waits for it to end (at
# most 60 seconds), and then saves the disk. boat supports this hook, but its documentation does not
# show it yet. The save copies files while they change, and a file that changed during the copy is
# restored torn. A database that Builders Bot wrote during the save was restored damaged. When Builders Bot is
# stopped first, the save sees no writes. A stop that boat does not complete leaves Builders Bot stopped
# until the next boot.
set -u

# The flag stops the starts until boat saves the disk: the Restart= of the unit, and the start at the
# end of an update request (buildersbot.service). /run is empty at each boot. boat can also keep the
# stopped machine in memory and continue it with no boot; then the account server removes the flag
# and starts Builders Bot (HELD_RESUME_START_COMMAND in apps/auth-api).
sudo -n touch /run/buildersbot-pre-stop || exit 1
# The unit stops Builders Bot with SIGTERM, and Builders Bot closes its database last. Builders Bot exits after 30
# seconds by itself. The 60 seconds of TimeoutStopSec are too long for the limit of boat. A killed
# Builders Bot leaves a database that SQLite recovers, because no copy runs while it ends.
if sudo -n timeout 40 systemctl stop buildersbot.service; then exit 0; fi
sudo -n systemctl kill --signal=SIGKILL buildersbot.service
for _ in $(seq 1 10); do
  case $(systemctl show --property=ActiveState --value buildersbot.service) in
    inactive | failed) exit 0 ;;
  esac
  sleep 0.5
done
exit 1
