# Downloads and unpacks a newer Builders Bot release next to the running one. buildersbot-update.timer starts
# it; buildersbot-update-apply.service moves the release into place at the next start of the server.
[Unit]
Description=Stage an Builders Bot update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/BuildersBot/hosted/buildersbot-hosted-update stage
Nice=19
IOSchedulingClass=idle
CPUWeight=idle
TimeoutStartSec=30min
